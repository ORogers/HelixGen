{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/helix-preset.schema.json",
  "title": "Line 6 Helix / Helix Native Preset (.hlx)",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "meta",
        "tone"
      ],
      "properties": {
        "device": {
          "type": "integer"
        },
        "device_version": {
          "type": "integer"
        },
        "meta": {
          "type": "object",
          "required": [
            "application",
            "appversion",
            "name"
          ],
          "properties": {
            "application": {
              "type": "string"
            },
            "appversion": {
              "type": [
                "integer",
                "string"
              ]
            },
            "build_sha": {
              "type": "string"
            },
            "modifieddate": {
              "type": [
                "integer",
                "string"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "tone": {
          "$ref": "#/$defs/Tone"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "Tone": {
      "type": "object",
      "properties": {
        "controller": {
          "type": "object"
        },
        "global": {
          "$ref": "#/$defs/Global"
        },
        "dsp0": {
          "$ref": "#/$defs/DSPGraph"
        },
        "dsp1": {
          "$ref": "#/$defs/DSPGraph"
        }
      },
      "patternProperties": {
        "^snapshot\\d+$": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "additionalProperties": true
    },
    "Global": {
      "type": "object",
      "properties": {
        "@current_snapshot": {
          "type": "integer"
        },
        "@tempo": {
          "type": "number"
        },
        "@model": {
          "type": "string"
        },
        "@cursor_dsp": {
          "type": "integer"
        },
        "@cursor_group": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^@.+$": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        }
      },
      "additionalProperties": true
    },
    "DSPGraph": {
      "type": "object",
      "properties": {
        "inputA": {
          "$ref": "#/$defs/InputNode"
        },
        "inputB": {
          "$ref": "#/$defs/InputNode"
        },
        "outputA": {
          "$ref": "#/$defs/OutputMainNode"
        },
        "outputB": {
          "$ref": "#/$defs/OutputSendNode"
        },
        "split": {
          "$ref": "#/$defs/SplitNode"
        },
        "join": {
          "$ref": "#/$defs/JoinNode"
        }
      },
      "patternProperties": {
        "^block\\d+$": {
          "$ref": "#/$defs/BlockNode"
        },
        "^cab\\d+$": {
          "$ref": "#/$defs/CabNode"
        }
      },
      "additionalProperties": true
    },
    "NodeBase": {
      "type": "object",
      "required": [
        "@model"
      ],
      "properties": {
        "@model": {
          "type": "string"
        },
        "@enabled": {
          "type": "boolean"
        },
        "@no_snapshot_bypass": {
          "type": "boolean"
        },
        "@path": {
          "type": "integer"
        },
        "@position": {
          "type": "integer"
        },
        "@type": {
          "type": "integer"
        },
        "@stereo": {
          "type": "boolean"
        },
        "@bypassvolume": {
          "type": "number"
        },
        "@mic": {
          "type": "integer"
        },
        "@cab": {
          "type": "string"
        },
        "@input": {
          "type": "integer"
        },
        "@output": {
          "type": "integer"
        }
      },
      "patternProperties": {
        "^@.+$": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "^(?!@).+$": {
          "type": [
            "number",
            "integer",
            "boolean",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "BlockNode": {
      "allOf": [
        {
          "$ref": "#/$defs/NodeBase"
        },
        {
          "type": "object",
          "required": [
            "@path",
            "@position"
          ]
        }
      ]
    },
    "CabNode": {
      "allOf": [
        {
          "$ref": "#/$defs/NodeBase"
        }
      ]
    },
    "InputNode": {
      "allOf": [
        {
          "$ref": "#/$defs/NodeBase"
        },
        {
          "type": "object",
          "required": [
            "@input"
          ]
        }
      ]
    },
    "OutputMainNode": {
      "allOf": [
        {
          "$ref": "#/$defs/NodeBase"
        },
        {
          "type": "object",
          "required": [
            "@output"
          ]
        }
      ]
    },
    "OutputSendNode": {
      "allOf": [
        {
          "$ref": "#/$defs/NodeBase"
        },
        {
          "type": "object",
          "required": [
            "@output"
          ]
        }
      ]
    },
    "SplitNode": {
      "allOf": [
        {
          "$ref": "#/$defs/NodeBase"
        },
        {
          "type": "object",
          "properties": {
            "BalanceA": {
              "type": [
                "number",
                "integer"
              ]
            },
            "BalanceB": {
              "type": [
                "number",
                "integer"
              ]
            },
            "bypass": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "JoinNode": {
      "allOf": [
        {
          "$ref": "#/$defs/NodeBase"
        },
        {
          "type": "object",
          "properties": {
            "A Level": {
              "type": [
                "number",
                "integer"
              ]
            },
            "A Pan": {
              "type": [
                "number",
                "integer"
              ]
            },
            "B Level": {
              "type": [
                "number",
                "integer"
              ]
            },
            "B Pan": {
              "type": [
                "number",
                "integer"
              ]
            },
            "B Polarity": {
              "type": "boolean"
            },
            "Level": {
              "type": [
                "number",
                "integer"
              ]
            }
          }
        }
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "@name": {
          "type": "string"
        },
        "@ledcolor": {
          "type": [
            "integer",
            "string"
          ]
        },
        "@tempo": {
          "type": "number"
        },
        "@custom_name": {
          "type": "boolean"
        },
        "@pedalstate": {
          "type": [
            "integer",
            "string"
          ]
        },
        "@valid": {
          "type": "boolean"
        },
        "blocks": {
          "type": "object",
          "properties": {
            "dsp0": {
              "type": "object",
              "patternProperties": {
                "^block\\d+$": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "dsp1": {
              "type": "object",
              "patternProperties": {
                "^block\\d+$": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "controllers": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}